rules_version = '2';

// Firestore POC 專用規則。寫入只透過 apps-script/Code.gs 用 OAuth token（走 IAM，
// 不受 Security Rules 限制）進行，所以這裡直接擋掉所有用戶端寫入，只開放讀取，
// 跟現在 Sheets bootstrap 對所有訪客公開讀取的安全模型一致。
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
