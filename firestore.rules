rules_version = '2';

// 全面脫離 Apps Script 之後的規則：
// - member_secrets：存密碼，任何人都不能透過用戶端讀寫，只有 Vercel Functions
//   用 Admin SDK（不受這份規則限制）能碰。
// - votes / signups：高頻動作，瀏覽器直接寫，用 Firebase Auth 的登入身分
//   （uid＝member_id）擋「只能改自己的票／自己報名退出」。
// - collections：「我也有這款」直接寫，只能新增/刪除自己（holder_id＝uid）
//   名下的收藏，不能動別人的。
// - game_corrections：使用者回報遊戲資料訂正，只能新增自己送出的（不能假冒
//   別人送出），送出後不能自己改／刪，審核（approve/reject）只能透過
//   Vercel Functions 的 Admin SDK。
// - 其他所有集合（members/venues/games/events/slots）：公開讀取，寫入一律
//   擋掉，只能透過 Vercel Functions 的 Admin SDK 寫。
service cloud.firestore {
  match /databases/{database}/documents {

    match /member_secrets/{memberId} {
      allow read, write: if false;
    }

    // username → member_id 對照表，登入查詢只在伺服器端（Admin SDK）做，
    // 不開放用戶端讀取（避免被掃出全部帳號清單），寫入只能透過 admin.js。
    match /usernames/{username} {
      allow read, write: if false;
    }

    match /votes/{voteId} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.resource.data.member_id == request.auth.uid;
      allow delete: if false;
    }

    match /signups/{signupId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.member_id == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.member_id == request.auth.uid;
      allow update: if false;
    }

    match /collections/{collectionId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.holder_id == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.holder_id == request.auth.uid;
      allow update: if false;
    }

    match /game_corrections/{correctionId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.submitted_by == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update, delete: if false;
    }

    // 幫某個場地新增遊戲的提議：任何人都能送，但套用到 collections 要 admin
    // 審核（api/admin.js 的 reviewVenueCollection），不是自己名下的東西不能直寫。
    match /venue_collection_requests/{requestId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.submitted_by == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update, delete: if false;
    }

    // tags：遊戲標籤清單，只能透過 admin.js 的 Admin SDK 新增/刪除。
    match /tags/{tagCode} {
      allow read: if true;
      allow write: if false;
    }

    // 提議新標籤：任何人都能送，通過才會真的變成正式標籤選項
    // （api/admin.js 的 reviewTagProposal）。
    match /tag_proposals/{proposalId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.submitted_by == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
